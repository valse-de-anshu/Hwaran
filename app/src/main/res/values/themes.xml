<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Main App Theme -->
    <style name="Theme.Hwaran.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Hwaran.Dark" parent="Theme.Hwaran.Main">
    </style>

    <!-- Full Screen Splash Theme (Fixes the root issue by bypassing system splash) -->
    <style name="Theme.Hwaran.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>

        <!-- 2. This disables the "Cold Start" black/icon screen entirely -->
        <item name="android:windowDisablePreview">true</item>

        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <!-- Dialog Theme for PopUpPlayerActivity -->
    <style name="Theme.Hwaran.Dialog" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>